{
  "name": "show-app",
  "version": "2.0.0",
  "private": true,
  "description": "Магазин: админка, продажи, смены, отчёты. Cloudflare Worker + D1 + KV",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:export": "wrangler d1 export show-app-db --remote --output backup/d1-backup.sql",
    "db:local": "wrangler d1 execute show-app-db --local --file backup/d1-backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
